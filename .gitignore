/Examples/
Automation/examples/*
!Automation/examples/demo-homepage.json
media-staging/
*.mp4
*.mov
*.webm

# Saved client pages, render checks, fetch-backs and upload manifests
*-comp*.html
*.stripped.html
fetchback/
render-check*/
UPLOAD-MANIFEST.txt
created-pages.json

# Third-party reference themes (licensed marketplace code; kept locally only)
References/

# Local tooling noise
node_modules/
*.log
.DS_Store
Thumbs.db
