# Per-portal settings for Agile automation scripts.
# Copy to .env.<portal> (e.g. .env.demo, .env.acme) and fill in. Never commit real values.
# Scripts pick the file with --portal <name>, e.g. node hubspot-api.js --portal demo ...

# HubSpot CLI account name for this portal (from `hs accounts list`)
HUBSPOT_ACCOUNT_NAME=
# Numeric portal ID. Scripts refuse to run if the token belongs to a different portal.
HUBSPOT_PORTAL_ID=

# Static access token of the "Agile page builder" app installed in this portal
# (Development > Projects > agile-page-builder > Agile page builder > Distribution tab > Show token).
# This is what API calls use. Needs the `content` scope.
HUBSPOT_ACCESS_TOKEN=

# App credentials (Development > Projects > agile-page-builder > Agile page builder > Auth).
# Not used for API calls by a static-auth app; kept for webhook/request signature checks.
HUBSPOT_APP_CLIENT_ID=
HUBSPOT_APP_CLIENT_SECRET=
