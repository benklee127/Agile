{
  "name": "cta",
  "label": "Call to action",
  "type": "group",
  "children": [
    {
      "name": "text",
      "label": "Button text",
      "type": "text",
      "default": "Learn more",
      "help_text": "Leave empty to hide the button."
    },
    {
      "name": "link",
      "label": "Button link",
      "type": "link",
      "supported_types": ["EXTERNAL", "CONTENT", "FILE", "EMAIL_ADDRESS", "BLOG", "PHONE_NUMBER"],
      "default": {
        "url": {
          "type": "EXTERNAL",
          "href": "#"
        },
        "open_in_new_tab": false,
        "no_follow": false
      }
    },
    {
      "name": "style",
      "label": "Button style",
      "type": "choice",
      "display": "select",
      "choices": [
        ["inherit", "Inherit"],
        ["primary", "Primary"],
        ["secondary", "Secondary"],
        ["ghost", "Ghost"],
        ["link", "Text link"]
      ],
      "default": "inherit"
    }
  ]
}
