        ["inherit", "Page default"],
        ["narrow", "Narrow"],
        ["default", "Standard"],
        ["wide", "Wide"],
        ["full", "Full width"]
      ],
      "default": "inherit"
    },
    {
      "name": "text_align",
      "label": "Text alignment",
      "type": "choice",
      "display": "select",
      "choices": [
        ["inherit", "Default"],
        ["left", "Left"],
        ["center", "Center"]
      ],
      "default": "inherit"
    }
  ]
}
