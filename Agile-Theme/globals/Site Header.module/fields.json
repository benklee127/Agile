[
  {
    "name": "content",
    "id": "content",
    "label": "Content",
    "type": "group",
    "children": [
      {
        "name": "logo",
        "id": "content__logo",
        "label": "Logo",
        "type": "image",
        "responsive": true,
        "resizable": false,
        "show_loading": false,
        "help_text": "Leave empty to use the theme logo (Theme settings > Branding > Site Logo)."
      },
      {
        "name": "logo_link",
        "id": "content__logo_link",
        "label": "Logo link",
        "type": "link",
        "supported_types": [
          "EXTERNAL",
          "CONTENT"
        ],
        "default": {
          "url": {
            "type": "EXTERNAL",
            "href": "/"
          },
          "open_in_new_tab": false,
          "no_follow": false
        }
      },
      {
        "name": "logo_alt",
        "id": "content__logo_alt",
        "label": "Company name (logo alt text)",
        "type": "text",
        "default": "",
        "help_text": "Used when the logo image has no alt text of its own, and shown as text when there is no logo at all."
      },
      {
        "name": "navigation_source",
        "id": "content__navigation_source",
        "label": "Navigation source",
        "type": "choice",
        "display": "radio",
        "choices": [
          [
            "agile",
            "Agile links (set below)"
          ],
          [
            "menu",
            "HubSpot menu"
          ]
        ],
        "default": "agile",
        "help_text": "Agile links are edited right here and work in any portal. HubSpot menu uses a menu from Settings > Website > Navigation."
      },
      {
        "name": "nav_links",
        "id": "content__nav_links",
        "label": "Navigation links",
        "type": "group",
        "occurrence": {
          "min": 0,
          "max": 8,
          "default": 4,
          "sorting_label_field": "content__nav_links__link_text"
        },
        "visibility": {
          "controlling_field_path": "content.navigation_source",
          "controlling_value_regex": "agile",
          "operator": "EQUAL"
        },
        "children": [
          {
            "name": "link_text",
            "id": "content__nav_links__link_text",
            "label": "Label",
            "type": "text",
            "default": "Link"
          },
          {
            "name": "link",
            "id": "content__nav_links__link",
            "label": "Link",
            "type": "link",
            "supported_types": [
              "EXTERNAL",
              "CONTENT",
              "FILE",
              "EMAIL_ADDRESS",
              "PHONE_NUMBER"
            ],
            "default": {
              "url": {
                "type": "EXTERNAL",
                "href": "#"
              },
              "open_in_new_tab": false,
              "no_follow": false
            }
          },
          {
            "name": "sub_links",
            "id": "content__nav_links__sub_links",
            "label": "Dropdown links",
            "type": "group",
            "occurrence": {
              "min": 0,
              "max": 8,
              "default": 0,
              "sorting_label_field": "content__nav_links__sub_links__link_text"
            },
            "help_text": "Optional. Adds a dropdown under this item.",
            "children": [
              {
                "name": "link_text",
                "id": "content__nav_links__sub_links__link_text",
                "label": "Label",
                "type": "text",
                "default": "Link"
              },
              {
                "name": "link",
                "id": "content__nav_links__sub_links__link",
                "label": "Link",
                "type": "link",
                "supported_types": [
                  "EXTERNAL",
                  "CONTENT",
                  "FILE",
                  "EMAIL_ADDRESS",
                  "PHONE_NUMBER"
                ],
                "default": {
                  "url": {
                    "type": "EXTERNAL",
                    "href": "#"
                  },
                  "open_in_new_tab": false,
                  "no_follow": false
                }
              }
            ]
          }
        ],
        "default": [
          {
            "link": {
              "url": {
                "type": "EXTERNAL",
                "href": "/about"
              },
              "open_in_new_tab": false,
              "no_follow": false
            },
            "sub_links": [],
            "link_text": "About"
          },
          {
            "link": {
              "url": {
                "type": "EXTERNAL",
                "href": "/services"
              },
              "open_in_new_tab": false,
              "no_follow": false
            },
            "sub_links": [
              {
                "link": {
                  "url": {
                    "type": "EXTERNAL",
                    "href": "/services/wealth-planning"
                  },
                  "open_in_new_tab": false,
                  "no_follow": false
                },
                "link_text": "Wealth planning"
              },
              {
                "link": {
                  "url": {
                    "type": "EXTERNAL",
                    "href": "/services/portfolio-management"
                  },
                  "open_in_new_tab": false,
                  "no_follow": false
                },
                "link_text": "Portfolio management"
              },
              {
                "link": {
                  "url": {
                    "type": "EXTERNAL",
                    "href": "/services/retirement-and-estate"
                  },
                  "open_in_new_tab": false,
                  "no_follow": false
                },
                "link_text": "Retirement and estate"
              }
            ],
            "link_text": "Services"
          },
          {
            "link": {
              "url": {
                "type": "EXTERNAL",
                "href": "/insights"
              },
              "open_in_new_tab": false,
              "no_follow": false
            },
            "sub_links": [],
            "link_text": "Insights"
          },
          {
            "link": {
              "url": {
                "type": "EXTERNAL",
                "href": "/contact"
              },
              "open_in_new_tab": false,
              "no_follow": false
            },
            "sub_links": [],
            "link_text": "Contact"
          }
        ]
      },
      {
        "name": "navigation",
        "id": "content__navigation",
        "label": "Navigation menu",
        "type": "menu",
        "default": "default",
        "help_text": "Top-level items show in the header. One level of child items shows as a dropdown; deeper levels are not shown.",
        "visibility": {
          "controlling_field_path": "content.navigation_source",
          "controlling_value_regex": "menu",
          "operator": "EQUAL"
        }
      },
      {
        "name": "cta",
        "id": "content__cta",
        "label": "Header button",
        "type": "group",
        "children": [
          {
            "name": "text",
            "id": "content__cta__text",
            "label": "Button text",
            "type": "text",
            "default": "Book a call",
            "help_text": "Leave empty to hide the button."
          },
          {
            "name": "link",
            "id": "content__cta__link",
            "label": "Button link",
            "type": "link",
            "supported_types": [
              "EXTERNAL",
              "CONTENT",
              "FILE",
              "EMAIL_ADDRESS",
              "BLOG",
              "PHONE_NUMBER"
            ],
            "default": {
              "url": {
                "type": "EXTERNAL",
                "href": "/contact"
              },
              "open_in_new_tab": false,
              "no_follow": false
            }
          },
          {
            "name": "style",
            "id": "content__cta__style",
            "label": "Button style",
            "type": "choice",
            "display": "select",
            "choices": [
              [
                "inherit",
                "Inherit"
              ],
              [
                "primary",
                "Primary"
              ],
              [
                "secondary",
                "Secondary"
              ],
              [
                "ghost",
                "Ghost"
              ],
              [
                "link",
                "Text link"
              ]
            ],
            "default": "inherit"
          }
        ]
      },
      {
        "name": "show_mobile_cta",
        "id": "content__show_mobile_cta",
        "label": "Show button in the mobile header bar",
        "type": "boolean",
        "display": "toggle",
        "default": false,
        "help_text": "On: the button stays visible next to the menu toggle on phones. Off: on phones it appears at the bottom of the opened menu. The minimal header always shows it."
      }
    ]
  },
  {
    "name": "style",
    "id": "style",
    "label": "Style",
    "type": "group",
    "tab": "STYLE",
    "children": [
      {
        "name": "logo_max_height",
        "id": "style__logo_max_height",
        "label": "Logo max height (desktop)",
        "type": "number",
        "display": "text",
        "suffix": "px",
        "min": 16,
        "max": 160,
        "step": 2,
        "default": 48
      },
      {
        "name": "logo_max_height_mobile",
        "id": "style__logo_max_height_mobile",
        "label": "Logo max height (mobile)",
        "type": "number",
        "display": "text",
        "suffix": "px",
        "min": 16,
        "max": 120,
        "step": 2,
        "default": 36,
        "help_text": "767px and below."
      }
    ]
  },
  {
    "name": "advanced",
    "id": "advanced",
    "label": "Advanced",
    "type": "group",
    "children": [
      {
        "name": "component_id",
        "id": "advanced__component_id",
        "label": "Anchor ID",
        "type": "text",
        "default": "",
        "help_text": "Sets the id attribute so you can link to this module with #anchor. Converted to lower case; spaces become hyphens and any characters other than letters, numbers, hyphens and underscores are removed (e.g. 'Our Pricing' becomes #our-pricing). Start with a letter."
      },
      {
        "name": "custom_class",
        "id": "advanced__custom_class",
        "label": "Custom CSS class",
        "type": "text",
        "default": "",
        "help_text": "Extra class names added to the module wrapper, separated by spaces."
      },
      {
        "name": "visibility",
        "id": "advanced__visibility",
        "label": "Visibility",
        "type": "group",
        "children": [
          {
            "name": "hide_on_mobile",
            "id": "advanced__visibility__hide_on_mobile",
            "label": "Hide on mobile",
            "type": "boolean",
            "display": "toggle",
            "default": false
          },
          {
            "name": "hide_on_desktop",
            "id": "advanced__visibility__hide_on_desktop",
            "label": "Hide on desktop",
            "type": "boolean",
            "display": "toggle",
            "default": false
          }
        ]
      }
    ]
  }
]
