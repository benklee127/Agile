[
  {
    "name": "content",
    "id": "content",
    "label": "Content",
    "type": "group",
    "children": [
      {
        "name": "logo",
        "id": "content__logo",
        "label": "Logo",
        "type": "image",
        "responsive": true,
        "resizable": false,
        "show_loading": false,
        "help_text": "Leave empty to use the theme logo (Theme settings > Branding > Site Logo)."
      },
      {
        "name": "logo_link",
        "id": "content__logo_link",
        "label": "Logo link",
        "type": "link",
        "supported_types": [
          "EXTERNAL",
          "CONTENT"
        ],
        "default": {
          "url": {
            "type": "EXTERNAL",
            "href": "/"
          },
          "open_in_new_tab": false,
          "no_follow": false
        }
      },
      {
        "name": "logo_alt",
        "id": "content__logo_alt",
        "label": "Company name (logo alt text)",
        "type": "text",
        "default": "",
        "help_text": "Used when the logo image has no alt text of its own, and shown as text when there is no logo at all."
      },
      {
        "name": "navigation",
        "id": "content__navigation",
        "label": "Navigation menu",
        "type": "menu",
        "default": "default",
        "help_text": "Top-level items show in the header. One level of child items shows as a dropdown; deeper levels are not shown."
      },
      {
        "name": "cta",
        "id": "content__cta",
        "label": "Header button",
        "type": "group",
        "children": [
          {
            "name": "text",
            "id": "content__cta__text",
            "label": "Button text",
            "type": "text",
            "default": "",
            "help_text": "Leave empty to hide the button."
          },
          {
            "name": "link",
            "id": "content__cta__link",
            "label": "Button link",
            "type": "link",
            "supported_types": [
              "EXTERNAL",
              "CONTENT",
              "FILE",
              "EMAIL_ADDRESS",
              "BLOG",
              "PHONE_NUMBER"
            ],
            "default": {
              "url": {
                "type": "EXTERNAL",
                "href": "#"
              },
              "open_in_new_tab": false,
              "no_follow": false
            }
          },
          {
            "name": "style",
            "id": "content__cta__style",
            "label": "Button style",
            "type": "choice",
            "display": "select",
            "choices": [
              [
                "inherit",
                "Inherit"
              ],
              [
                "primary",
                "Primary"
              ],
              [
                "secondary",
                "Secondary"
              ],
              [
                "ghost",
                "Ghost"
              ],
              [
                "link",
                "Text link"
              ]
            ],
            "default": "inherit"
          }
        ]
      },
      {
        "name": "show_mobile_cta",
        "id": "content__show_mobile_cta",
        "label": "Show button in the mobile header bar",
        "type": "boolean",
        "display": "toggle",
        "default": false,
        "help_text": "On: the button stays visible next to the menu toggle on phones. Off: on phones it appears at the bottom of the opened menu. The minimal header always shows it."
      }
    ]
  },
  {
    "name": "style",
    "id": "style",
    "label": "Style",
    "type": "group",
    "tab": "STYLE",
    "children": [
      {
        "name": "logo_max_height",
        "id": "style__logo_max_height",
        "label": "Logo max height (desktop)",
        "type": "number",
        "display": "text",
        "suffix": "px",
        "min": 16,
        "max": 160,
        "step": 2,
        "default": 48
      },
      {
        "name": "logo_max_height_mobile",
        "id": "style__logo_max_height_mobile",
        "label": "Logo max height (mobile)",
        "type": "number",
        "display": "text",
        "suffix": "px",
        "min": 16,
        "max": 120,
        "step": 2,
        "default": 36,
        "help_text": "767px and below."
      }
    ]
  },
  {
    "name": "advanced",
    "id": "advanced",
    "label": "Advanced",
    "type": "group",
    "children": [
      {
        "name": "component_id",
        "id": "advanced__component_id",
        "label": "Anchor ID",
        "type": "text",
        "default": "",
        "help_text": "Sets the id attribute so you can link to this module with #anchor. Converted to lower case; spaces become hyphens and any characters other than letters, numbers, hyphens and underscores are removed (e.g. 'Our Pricing' becomes #our-pricing). Start with a letter."
      },
      {
        "name": "custom_class",
        "id": "advanced__custom_class",
        "label": "Custom CSS class",
        "type": "text",
        "default": "",
        "help_text": "Extra class names added to the module wrapper, separated by spaces."
      },
      {
        "name": "visibility",
        "id": "advanced__visibility",
        "label": "Visibility",
        "type": "group",
        "children": [
          {
            "name": "hide_on_mobile",
            "id": "advanced__visibility__hide_on_mobile",
            "label": "Hide on mobile",
            "type": "boolean",
            "display": "toggle",
            "default": false
          },
          {
            "name": "hide_on_desktop",
            "id": "advanced__visibility__hide_on_desktop",
            "label": "Hide on desktop",
            "type": "boolean",
            "display": "toggle",
            "default": false
          }
        ]
      }
    ]
  }
]
