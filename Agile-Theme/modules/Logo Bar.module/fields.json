[
  {
    "name": "content",
    "id": "content",
    "label": "Content",
    "type": "group",
    "children": [
      {
        "name": "heading",
        "id": "content__heading",
        "label": "Heading",
        "type": "text",
        "default": "Trusted by leading companies",
        "help_text": "Short label above the logos. Leave blank to hide it."
      },
      {
        "name": "heading_level",
        "id": "content__heading_level",
        "label": "Heading level",
        "type": "choice",
        "display": "select",
        "choices": [
          [
            "h1",
            "H1"
          ],
          [
            "h2",
            "H2"
          ],
          [
            "h3",
            "H3"
          ],
          [
            "h4",
            "H4"
          ]
        ],
        "default": "h2",
        "help_text": "Semantic level only; the label keeps its small visual style."
      },
      {
        "name": "logos",
        "id": "content__logos",
        "label": "Logos",
        "type": "group",
        "occurrence": {
          "min": 1,
          "max": 20,
          "default": 5,
          "sorting_label_field": "content__logos__alt_text"
        },
        "children": [
          {
            "name": "logo",
            "id": "content__logos__logo",
            "label": "Logo image",
            "type": "image",
            "responsive": true,
            "resizable": false,
            "show_loading": false
          },
          {
            "name": "alt_text",
            "id": "content__logos__alt_text",
            "label": "Company name (alt text)",
            "type": "text",
            "default": "",
            "help_text": "Used as the logo's alt text and the list label. Falls back to the image's own alt text."
          },
          {
            "name": "link",
            "id": "content__logos__link",
            "label": "Link (optional)",
            "type": "link",
            "supported_types": [
              "EXTERNAL",
              "CONTENT",
              "BLOG",
              "FILE"
            ],
            "default": {
              "url": {
                "type": "EXTERNAL",
                "href": ""
              },
              "open_in_new_tab": true,
              "no_follow": true
            }
          }
        ]
      }
    ]
  },
  {
    "name": "layout",
    "id": "layout",
    "label": "Layout",
    "type": "group",
    "children": [
      {
        "name": "spacing",
        "id": "layout__spacing",
        "label": "Spacing",
        "type": "group",
        "children": [
          {
            "name": "padding_top",
            "id": "layout__spacing__padding_top",
            "label": "Top padding",
            "type": "choice",
            "display": "select",
            "choices": [
              [
                "theme",
                "Theme default"
              ],
              [
                "none",
                "None"
              ],
              [
                "xs",
                "XS"
              ],
              [
                "sm",
                "Small"
              ],
              [
                "md",
                "Medium"
              ],
              [
                "lg",
                "Large"
              ],
              [
                "xl",
                "XL"
              ],
              [
                "custom",
                "Custom"
              ]
            ],
            "default": "theme"
          },
          {
            "name": "padding_top_custom",
            "id": "layout__spacing__padding_top_custom",
            "label": "Custom top padding",
            "type": "number",
            "display": "text",
            "min": 0,
            "step": 4,
            "suffix": "px",
            "default": 80,
            "visibility": {
              "controlling_field_path": "layout.spacing.padding_top",
              "controlling_value_regex": "custom",
              "operator": "EQUAL"
            }
          },
          {
            "name": "padding_bottom",
            "id": "layout__spacing__padding_bottom",
            "label": "Bottom padding",
            "type": "choice",
            "display": "select",
            "choices": [
              [
                "theme",
                "Theme default"
              ],
              [
                "none",
                "None"
              ],
              [
                "xs",
                "XS"
              ],
              [
                "sm",
                "Small"
              ],
              [
                "md",
                "Medium"
              ],
              [
                "lg",
                "Large"
              ],
              [
                "xl",
                "XL"
              ],
              [
                "custom",
                "Custom"
              ]
            ],
            "default": "theme"
          },
          {
            "name": "padding_bottom_custom",
            "id": "layout__spacing__padding_bottom_custom",
            "label": "Custom bottom padding",
            "type": "number",
            "display": "text",
            "min": 0,
            "step": 4,
            "suffix": "px",
            "default": 80,
            "visibility": {
              "controlling_field_path": "layout.spacing.padding_bottom",
              "controlling_value_regex": "custom",
              "operator": "EQUAL"
            }
          }
        ]
      },
      {
        "name": "container_width",
        "id": "layout__container_width",
        "label": "Container width",
        "type": "choice",
        "display": "select",
        "choices": [
          [
            "inherit",
            "Page default"
          ],
          [
            "narrow",
            "Narrow"
          ],
          [
            "default",
            "Standard"
          ],
          [
            "wide",
            "Wide"
          ],
          [
            "full",
            "Full width"
          ]
        ],
        "default": "inherit"
      },
      {
        "name": "text_align",
        "id": "layout__text_align",
        "label": "Text alignment",
        "type": "choice",
        "display": "select",
        "choices": [
          [
            "inherit",
            "Default"
          ],
          [
            "left",
            "Left"
          ],
          [
            "center",
            "Center"
          ]
        ],
        "default": "inherit"
      },
      {
        "name": "columns",
        "id": "layout__columns",
        "label": "Logos per row",
        "type": "choice",
        "display": "select",
        "choices": [
          [
            "3",
            "3"
          ],
          [
            "4",
            "4"
          ],
          [
            "5",
            "5"
          ],
          [
            "6",
            "6"
          ]
        ],
        "default": "5",
        "help_text": "Desktop only. Tablets and phones show 3 and 2 per row."
      },
      {
        "name": "logo_max_height",
        "id": "layout__logo_max_height",
        "label": "Logo max height",
        "type": "number",
        "display": "text",
        "min": 20,
        "max": 160,
        "step": 4,
        "suffix": "px",
        "default": 48
      }
    ]
  },
  {
    "name": "style",
    "id": "style",
    "label": "Style",
    "type": "group",
    "tab": "STYLE",
    "children": [
      {
        "name": "background",
        "id": "style__background",
        "label": "Background",
        "type": "choice",
        "display": "select",
        "choices": [
          [
            "inherit",
            "None (page background)"
          ],
          [
            "surface",
            "Surface"
          ],
          [
            "primary",
            "Primary"
          ],
          [
            "secondary",
            "Secondary"
          ],
          [
            "accent",
            "Accent"
          ],
          [
            "custom",
            "Custom colour"
          ]
        ],
        "default": "inherit"
      },
      {
        "name": "background_color",
        "id": "style__background_color",
        "label": "Custom background colour",
        "type": "color",
        "default": {
          "color": null,
          "opacity": null
        },
        "visibility": {
          "controlling_field_path": "style.background",
          "controlling_value_regex": "custom",
          "operator": "EQUAL"
        }
      },
      {
        "name": "text_color",
        "id": "style__text_color",
        "label": "Text colour",
        "type": "color",
        "help_text": "Leave empty to inherit the text colour from the background choice or the page.",
        "show_opacity": false,
        "default": {
          "color": null,
          "opacity": null
        }
      },
      {
        "name": "logo_treatment",
        "id": "style__logo_treatment",
        "label": "Logo treatment",
        "type": "choice",
        "display": "select",
        "choices": [
          [
            "original",
            "Original colours"
          ],
          [
            "grayscale",
            "Grayscale"
          ],
          [
            "grayscale-hover",
            "Grayscale (colour on hover)"
          ]
        ],
        "default": "grayscale-hover"
      }
    ]
  },
  {
    "name": "advanced",
    "id": "advanced",
    "label": "Advanced",
    "type": "group",
    "children": [
      {
        "name": "component_id",
        "id": "advanced__component_id",
        "label": "Anchor ID",
        "type": "text",
        "default": "",
        "help_text": "Sets the id attribute so you can link to this module with #anchor. Converted to lower case; spaces become hyphens and any characters other than letters, numbers, hyphens and underscores are removed (e.g. 'Our Pricing' becomes #our-pricing). Start with a letter."
      },
      {
        "name": "custom_class",
        "id": "advanced__custom_class",
        "label": "Custom CSS class",
        "type": "text",
        "default": "",
        "help_text": "Extra class names added to the module wrapper, separated by spaces."
      },
      {
        "name": "visibility",
        "id": "advanced__visibility",
        "label": "Visibility",
        "type": "group",
        "children": [
          {
            "name": "hide_on_mobile",
            "id": "advanced__visibility__hide_on_mobile",
            "label": "Hide on mobile",
            "type": "boolean",
            "display": "toggle",
            "default": false
          },
          {
            "name": "hide_on_desktop",
            "id": "advanced__visibility__hide_on_desktop",
            "label": "Hide on desktop",
            "type": "boolean",
            "display": "toggle",
            "default": false
          }
        ]
      }
    ]
  }
]
