[
  {
    "name": "content",
    "id": "content",
    "label": "Content",
    "type": "group",
    "children": [
      {
        "name": "image",
        "id": "content__image",
        "label": "Card image",
        "type": "image",
        "responsive": true,
        "resizable": true,
        "help_text": "Optional. Shown at the top of the card, cropped to 16:9."
      },
      {
        "name": "eyebrow",
        "id": "content__eyebrow",
        "label": "Eyebrow",
        "type": "text",
        "default": "",
        "help_text": "Optional short label above the heading."
      },
      {
        "name": "heading",
        "id": "content__heading",
        "label": "Heading",
        "type": "text",
        "default": "Card heading"
      },
      {
        "name": "heading_level",
        "id": "content__heading_level",
        "label": "Heading level",
        "type": "choice",
        "display": "select",
        "choices": [
          [
            "h1",
            "H1"
          ],
          [
            "h2",
            "H2"
          ],
          [
            "h3",
            "H3"
          ],
          [
            "h4",
            "H4"
          ]
        ],
        "default": "h3",
        "help_text": "Semantic level for the page outline. Choose the level below the section heading the card sits under."
      },
      {
        "name": "body_text",
        "id": "content__body_text",
        "label": "Body",
        "type": "richtext",
        "default": "<p>Card body text goes here. Describe the item, feature, or content.</p>"
      },
      {
        "name": "cta",
        "id": "content__cta",
        "label": "Button",
        "type": "group",
        "children": [
          {
            "name": "text",
            "id": "content__cta__text",
            "label": "Button text",
            "type": "text",
            "default": "",
            "help_text": "Leave empty to hide the button."
          },
          {
            "name": "link",
            "id": "content__cta__link",
            "label": "Button link",
            "type": "link",
            "supported_types": [
              "EXTERNAL",
              "CONTENT",
              "FILE",
              "EMAIL_ADDRESS",
              "BLOG",
              "PHONE_NUMBER"
            ],
            "default": {
              "url": {
                "type": "EXTERNAL",
                "href": "#"
              },
              "open_in_new_tab": false,
              "no_follow": false
            }
          },
          {
            "name": "style",
            "id": "content__cta__style",
            "label": "Button style",
            "type": "choice",
            "display": "select",
            "choices": [
              [
                "inherit",
                "Inherit"
              ],
              [
                "primary",
                "Primary"
              ],
              [
                "secondary",
                "Secondary"
              ],
              [
                "ghost",
                "Ghost"
              ],
              [
                "link",
                "Text link"
              ]
            ],
            "default": "inherit"
          }
        ]
      }
    ]
  },
  {
    "name": "style",
    "id": "style",
    "label": "Style",
    "type": "group",
    "tab": "STYLE",
    "children": [
      {
        "name": "card_style",
        "id": "style__card_style",
        "label": "Card style",
        "type": "choice",
        "display": "select",
        "choices": [
          [
            "default",
            "Raised (shadow)"
          ],
          [
            "outlined",
            "Outlined (border)"
          ],
          [
            "flat",
            "Flat (no frame)"
          ]
        ],
        "default": "default",
        "help_text": "Raised and Outlined cards keep the default page colours inside coloured sections. Flat cards take the section's colours."
      }
    ]
  },
  {
    "name": "advanced",
    "id": "advanced",
    "label": "Advanced",
    "type": "group",
    "children": [
      {
        "name": "component_id",
        "id": "advanced__component_id",
        "label": "Anchor ID",
        "type": "text",
        "default": "",
        "help_text": "Sets the id attribute so you can link to this module with #anchor. Converted to lower case; spaces become hyphens and any characters other than letters, numbers, hyphens and underscores are removed (e.g. 'Our Pricing' becomes #our-pricing). Start with a letter."
      },
      {
        "name": "custom_class",
        "id": "advanced__custom_class",
        "label": "Custom CSS class",
        "type": "text",
        "default": "",
        "help_text": "Extra class names added to the module wrapper, separated by spaces."
      },
      {
        "name": "visibility",
        "id": "advanced__visibility",
        "label": "Visibility",
        "type": "group",
        "children": [
          {
            "name": "hide_on_mobile",
            "id": "advanced__visibility__hide_on_mobile",
            "label": "Hide on mobile",
            "type": "boolean",
            "display": "toggle",
            "default": false
          },
          {
            "name": "hide_on_desktop",
            "id": "advanced__visibility__hide_on_desktop",
            "label": "Hide on desktop",
            "type": "boolean",
            "display": "toggle",
            "default": false
          }
        ]
      }
    ]
  }
]
